<?xml version="1.0" encoding="utf-8"?>
<!-- One saved server profile row (qBitController-style server manager). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profileCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <RadioButton
        android:id="@+id/profileActive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/profileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            tools:text="Home server" />

        <TextView
            android:id="@+id/profileHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="192.168.1.10:8080" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/profileEdit"
        style="?attr/borderlessButtonStyle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/server_edit"
        android:src="@drawable/ic_edit_24px"
        tools:ignore="ContentDescription" />

    <ImageButton
        android:id="@+id/profileDelete"
        style="?attr/borderlessButtonStyle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/rss_delete"
        android:src="@drawable/ic_delete_24px" />
</LinearLayout>
