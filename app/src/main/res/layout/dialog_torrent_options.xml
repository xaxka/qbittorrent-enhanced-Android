<?xml version="1.0" encoding="utf-8"?>
<!-- qBitController TorrentOptionsDialog parity: auto TMM, save path,
     download path, speed limits, share limits, sequential download and
     first/last piece priority — one dialog for every per-torrent option. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/auto_tmm_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="@string/torrent_option_automatic_torrent_management" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/torrent_option_save_path">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/save_path_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/download_path_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="@string/torrent_option_download_path_enable" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/torrent_option_download_path">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/download_path_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/torrent_option_upload_speed_limit"
            app:helperText="@string/limit_helper_unlimited">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/torrent_upload_limit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberSigned|numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/torrent_option_download_speed_limit"
            app:helperText="@string/limit_helper_unlimited">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/torrent_download_limit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberSigned|numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <RadioGroup
            android:id="@+id/share_limit_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/share_limit_global"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/torrent_option_share_limit_global" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/share_limit_disable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/torrent_option_share_limit_disable" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/share_limit_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/torrent_option_share_limit_custom" />
        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/torrent_option_share_limit_ratio">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/torrent_ratio_limit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberSigned|numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/torrent_option_share_limit_total_minutes">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/torrent_seeding_time_limit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberSigned" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/torrent_option_share_limit_inactive_minutes">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/torrent_inactive_seeding_time_limit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberSigned" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/share_limit_action">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/share_limit_action_dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sequential_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="@string/torrent_option_sequential_download" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/first_last_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="@string/torrent_option_prioritize_first_last_piece" />
    </LinearLayout>
</ScrollView>
