<?xml version="1.0" encoding="utf-8"?>
<!-- One node of the RSS tree, qBC FeedItem parity: elevated card, expand
     arrow (or a 48dp placeholder when the folder has no children), rss /
     folder icon, name, per-node overflow menu. Tree depth = card start
     padding, applied in code (level * 12dp). The summary line is used by
     the rules tab (same layout), hidden for tree nodes. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    style="?attr/materialCardViewElevatedStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/expand_arrow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_keyboard_arrow_down_24px"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:visibility="visible" />

        <Space
            android:id="@+id/arrow_spacer"
            android:layout_width="48dp"
            android:layout_height="1dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            app:srcCompat="@drawable/ic_rss_feed_24px"
            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                style="?attr/textAppearanceBodyLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Feed name" />

            <TextView
                android:id="@+id/url"
                style="@style/App.Components.ListItem.SupportingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:visibility="gone"
                tools:text="must contain: linux"
                tools:visibility="visible" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/node_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            app:srcCompat="@drawable/ic_more_vert_24px"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
