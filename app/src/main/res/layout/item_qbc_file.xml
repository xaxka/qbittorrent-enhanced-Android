<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the torrent content tree, qBC FileItem parity: elevated card
     indented by folder depth, expand arrow (folders) / 48dp inset (files),
     type icon, name, priority-colored progress bar and detail line. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/file_card"
    style="@style/Widget.Material3.CardView.Elevated"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- Download toggle: checked = downloads, unchecked = skipped
             (priority 0), indeterminate = folder with mixed priorities. -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/file_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:contentDescription="@null" />

        <ImageButton
            android:id="@+id/expand_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_keyboard_arrow_down_24px"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageView
            android:id="@+id/type_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            android:src="@drawable/ic_folder_24px"
            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/file_name"
                style="?attr/textAppearanceBodyLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="ubuntu-24.04.1-desktop-amd64.iso" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/file_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/file_details"
                style="?attr/textAppearanceBodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Normal • 1.2 GiB / 4.4 GiB • 27.5%" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
