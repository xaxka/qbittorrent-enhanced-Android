<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/qbt_advanced_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/qbt_async_io_threads">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/asyncIoThreadsInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/qbt_hashing_threads">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/hashingThreadsInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/qbt_checking_mem">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/checkingMemInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/announceAllSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/qbt_announce_all" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/announceAllTiersSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/qbt_announce_all_tiers" />

        <TextView
            style="@style/TextAppearance.App.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/qbt_adv_storage_section" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/qbt_resume_data_storage">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/resumeStorageDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/qbt_save_resume_interval_min">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/saveResumeIntervalInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/qbt_memory_working_set_mb">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/memoryWorkingSetInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/qbt_torrent_file_size_limit_mb">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/torrentFileSizeLimitInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/TextAppearance.App.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/qbt_adv_files_section" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/excludedNamesSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/qbt_excluded_names_enabled" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/qbt_excluded_names">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/excludedNamesInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/qbt_python_path">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/pythonPathInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textNoSuggestions" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/TextAppearance.App.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/qbt_adv_behavior_section" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/confirmDeletionSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/qbt_confirm_deletion" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/confirmRecheckSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/qbt_confirm_recheck" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/deleteContentSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/qbt_delete_content_default" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/resolveCountriesSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/qbt_resolve_peer_countries" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/resolveHostNamesSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/qbt_resolve_peer_hostnames" />

        <TextView
            style="@style/TextAppearance.App.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/qbt_adv_log_section" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/fileLogSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/qbt_file_log_enabled" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/qbt_file_log_path">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/fileLogPathInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textNoSuggestions" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/fileLogBackupSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/qbt_file_log_backup" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/qbt_file_log_max_size_kib">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/fileLogMaxSizeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/fileLogDeleteOldSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/qbt_file_log_delete_old" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/qbt_file_log_age">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/fileLogAgeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/qbt_file_log_age_type">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/fileLogAgeTypeDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</ScrollView>
