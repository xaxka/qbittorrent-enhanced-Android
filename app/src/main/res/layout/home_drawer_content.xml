<?xml version="1.0" encoding="utf-8"?>
<!-- Port of LibreTorrent home_drawer_content.xml (GPL-3.0):
     stats rows + filter sections, same styles/margins as the original.
     Filter chips are laid out in fixed 3-column grids (EqualColumnsChipGroup)
     rendered as centered-label grid buttons (see Widget.App.Chip.Filter).
     The content column is 0dp-padded so EVERY section — stat rows, section
     titles, dividers and the chip grids — aligns on the same 16dp inset;
     gaps are the M3 standard 8dp. The status set mirrors the engine's own
     WebUI sidebar (views/filters.html); the date-added window filters were
     dropped — qBittorrent offers no such sidebar filters, the "Date added"
     sort covers that need. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nested_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="12dp">

        <!-- Stats: compact settings-style rows — icon + muted label on the
             left, live value right-aligned, 8dp rhythm between rows. All
             section headers (统计/筛选/…) use TitleMedium so the drawer reads
             as one coherent panel instead of a mix of oversized and small
             titles. The engine RSS figure was dropped from the port row:
             it is engine-internal noise, not something a user can act on. -->
        <TextView
            style="?attr/textAppearanceTitleMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            android:text="@string/stats" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/stat_row_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <TextView
                    style="@style/App.Components.ListItem.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="16dp"
                    android:text="@string/listen_port_stat"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:drawableStartCompat="@drawable/ic_lan_24px" />

                <TextView
                    android:id="@+id/session_listen_port_stat"
                    style="@style/App.Components.ListItem.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="6881" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stat_row_dht"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <TextView
                    style="@style/App.Components.ListItem.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="16dp"
                    android:text="@string/drawer_stat_dht"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:drawableStartCompat="@drawable/ic_hub_24px" />

                <TextView
                    android:id="@+id/session_dht_nodes_stat"
                    style="@style/App.Components.ListItem.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="100" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stat_row_download"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <TextView
                    style="@style/App.Components.ListItem.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="16dp"
                    android:text="@string/drawer_stat_download"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:drawableStartCompat="@drawable/ic_download_24px" />

                <TextView
                    android:id="@+id/session_download_stat"
                    style="@style/App.Components.ListItem.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="1.2 GiB • 1.5 MiB/s" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stat_row_upload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <TextView
                    style="@style/App.Components.ListItem.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="16dp"
                    android:text="@string/drawer_stat_upload"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:drawableStartCompat="@drawable/ic_upload_24px" />

                <TextView
                    android:id="@+id/session_upload_stat"
                    style="@style/App.Components.ListItem.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="300 MiB • 200 KiB/s" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp" />

        <TextView
            style="?attr/textAppearanceTitleMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="4dp"
            android:text="@string/filters" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp">

            <TextView
                style="?attr/textAppearanceTitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/status_clear_button"
                android:text="@string/drawer_status" />

            <Button
                android:id="@+id/status_clear_button"
                style="?attr/materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:contentDescription="@string/reset_filter"
                app:icon="@drawable/ic_filter_list_off_24px" />
        </RelativeLayout>

        <io.github.xixka.qbittorrent.ui.customviews.EqualColumnsChipGroup
            android:id="@+id/drawer_status_chip_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/drawer_status_all"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/drawer_status_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/drawer_status_downloading"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/drawer_status_downloading" />

            <com.google.android.material.chip.Chip
                android:id="@+id/drawer_status_seeding"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/drawer_status_seeding" />

            <com.google.android.material.chip.Chip
                android:id="@+id/drawer_status_completed"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/drawer_status_completed" />

            <com.google.android.material.chip.Chip
                android:id="@+id/drawer_status_resumed"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/drawer_status_resumed" />

            <com.google.android.material.chip.Chip
                android:id="@+id/drawer_status_paused"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/drawer_status_paused" />

            <com.google.android.material.chip.Chip
                android:id="@+id/drawer_status_active"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/drawer_status_active" />

            <com.google.android.material.chip.Chip
                android:id="@+id/drawer_status_inactive"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/drawer_status_inactive" />

            <com.google.android.material.chip.Chip
                android:id="@+id/drawer_status_stalled"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/drawer_status_stalled" />

            <com.google.android.material.chip.Chip
                android:id="@+id/drawer_status_checking"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/drawer_status_checking" />

            <com.google.android.material.chip.Chip
                android:id="@+id/drawer_status_moving"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/drawer_status_moving" />

            <com.google.android.material.chip.Chip
                android:id="@+id/drawer_status_error"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/drawer_status_error" />
        </io.github.xixka.qbittorrent.ui.customviews.EqualColumnsChipGroup>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp">

            <TextView
                style="?attr/textAppearanceTitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/sort_direction_toggle_button"
                android:text="@string/drawer_sorting" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/sort_direction_toggle_button"
                style="@style/Widget.Material3.MaterialButtonGroup.Connected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                app:checkedButton="@id/sort_desc_button"
                app:singleSelection="true">

                <Button
                    android:id="@+id/sort_desc_button"
                    style="?attr/materialIconButtonFilledTonalStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/descending_sort"
                    app:icon="@drawable/ic_sort_desc_24px" />

                <Button
                    android:id="@+id/sort_asc_button"
                    style="?attr/materialIconButtonFilledTonalStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/ascending_sort"
                    app:icon="@drawable/ic_sort_24px" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </RelativeLayout>

        <io.github.xixka.qbittorrent.ui.customviews.EqualColumnsChipGroup
            android:id="@+id/drawer_sorting_chip_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp"
            app:singleSelection="true"
            tools:checkedChip="@id/drawer_sorting_date_added">

            <com.google.android.material.chip.Chip
                android:id="@+id/drawer_sorting_date_added"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/drawer_sorting_date_added" />

            <com.google.android.material.chip.Chip
                android:id="@+id/drawer_sorting_name"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/drawer_sorting_name" />

            <com.google.android.material.chip.Chip
                android:id="@+id/drawer_sorting_size"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/drawer_sorting_size" />

            <com.google.android.material.chip.Chip
                android:id="@+id/drawer_sorting_progress"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/drawer_sorting_progress" />

            <com.google.android.material.chip.Chip
                android:id="@+id/drawer_sorting_ETA"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/drawer_sorting_ETA" />

            <com.google.android.material.chip.Chip
                android:id="@+id/drawer_sorting_ratio"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/drawer_sorting_ratio" />

            <com.google.android.material.chip.Chip
                android:id="@+id/drawer_sorting_peers"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/drawer_sorting_peers" />

            <com.google.android.material.chip.Chip
                android:id="@+id/drawer_sorting_dl_speed"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/drawer_sorting_dl_speed" />

            <com.google.android.material.chip.Chip
                android:id="@+id/drawer_sorting_up_speed"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/drawer_sorting_up_speed" />

            <com.google.android.material.chip.Chip
                android:id="@+id/drawer_sorting_uploaded"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/drawer_sorting_uploaded" />

            <com.google.android.material.chip.Chip
                android:id="@+id/drawer_sorting_completion_date"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/drawer_sorting_completion_date" />
        </io.github.xixka.qbittorrent.ui.customviews.EqualColumnsChipGroup>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp">

            <TextView
                style="?attr/textAppearanceTitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/add_category_button"
                android:text="@string/categories" />

            <Button
                android:id="@+id/add_category_button"
                style="?attr/materialIconButtonFilledTonalStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/categories_clear_button"
                android:contentDescription="@string/add_category"
                app:icon="@drawable/ic_add_24px" />

            <Button
                android:id="@+id/categories_clear_button"
                style="?attr/materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:contentDescription="@string/reset_filter"
                app:icon="@drawable/ic_filter_list_off_24px" />
        </RelativeLayout>

        <io.github.xixka.qbittorrent.ui.customviews.EqualColumnsChipGroup
            android:id="@+id/drawer_categories_chip_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/no_category_chip"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/no_tags" />
        </io.github.xixka.qbittorrent.ui.customviews.EqualColumnsChipGroup>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp">

            <TextView
                style="?attr/textAppearanceTitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/add_tag_button"
                android:text="@string/tags" />

            <Button
                android:id="@+id/add_tag_button"
                style="?attr/materialIconButtonFilledTonalStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/tags_clear_button"
                android:contentDescription="@string/add_tag"
                app:icon="@drawable/ic_add_24px" />

            <Button
                android:id="@+id/tags_clear_button"
                style="?attr/materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:contentDescription="@string/reset_filter"
                app:icon="@drawable/ic_filter_list_off_24px" />
        </RelativeLayout>

        <io.github.xixka.qbittorrent.ui.customviews.EqualColumnsChipGroup
            android:id="@+id/drawer_tags_chip_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/no_tags_chip"
                style="@style/Widget.App.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/no_tags" />
        </io.github.xixka.qbittorrent.ui.customviews.EqualColumnsChipGroup>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
