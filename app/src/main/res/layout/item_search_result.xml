<?xml version="1.0" encoding="utf-8"?>
<!-- One search result row (qBitController parity). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    style="@style/App.Components.ListItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="12dp"
        android:minHeight="@dimen/list_item_two_lines_height"
        android:orientation="vertical">

        <TextView
            android:id="@+id/file_name"
            style="@style/App.Components.ListItem.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            tools:text="Ubuntu 24.04 LTS" />

        <TextView
            android:id="@+id/file_site"
            style="@style/App.Components.ListItem.SupportingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            tools:text="site: linuxtracker.org" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/file_size"
                style="@style/App.Components.ListItem.SupportingText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="4.2 GiB" />

            <TextView
                android:id="@+id/seeders_leechers"
                style="@style/App.Components.ListItem.SupportingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                tools:text="↑ 128 ↓ 5" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
