<?xml version="1.0" encoding="utf-8"?>
<!-- RSS auto-download rule editor, qBC EditRssRuleScreen parity:
     checkboxes (enabled / regex / smart filter / save-to-other-dir),
     text fields (must contain / must not contain / episode filter /
     save to / ignore days) and exposed dropdowns (category from the
     server, add paused: global/always/never, torrent content layout:
     global/original/subfolder/no-subfolder), plus the bordered
     "apply rule to feeds" checkbox list. Fields are spaced 8dp like
     qBC's spacedBy(8.dp). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/rule_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rss_rule_enabled" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/rule_use_regex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rss_rule_use_regex" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/rss_rule_must_contain">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/rule_must_contain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/rss_rule_must_not_contain">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/rule_must_not_contain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/rss_rule_episode_filter">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/rule_episode_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/rule_smart_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rss_rule_smart_filter" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/rss_rule_category">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/rule_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/rule_save_other_dir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/rss_rule_save_other_dir" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/rule_save_path_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/rss_rule_save_path"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/rule_save_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/rss_rule_ignore_days">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/rule_ignore_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/rss_rule_add_paused">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/rule_add_paused"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/rss_rule_content_layout">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/rule_content_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:text="@string/rss_rule_apply_rule_to_feeds"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?attr/materialCardViewOutlinedStyle"
            app:cardCornerRadius="4dp"
            app:contentPadding="8dp"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/rule_feeds_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/rule_no_feeds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/rss_rule_no_feed_found"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorError"
                android:visibility="gone" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
