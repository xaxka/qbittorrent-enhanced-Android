<?xml version="1.0" encoding="utf-8"?>
<!-- qBC CategoryChip: 8dp-rounded primaryContainer block, labelLarge text,
     padding 6/6/12/16 (the trailing room is where the selection check icon
     would appear in selectable contexts). Display-only in the overview
     progress card. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    style="?attr/textAppearanceLabelLarge"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_category_chip"
    android:ellipsize="end"
    android:maxLines="1"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp"
    android:textColor="?attr/colorOnPrimaryContainer" />
