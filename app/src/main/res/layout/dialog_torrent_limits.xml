<?xml version="1.0" encoding="utf-8"?>
<!-- Per-torrent speed & share limits dialog (qBitController parity). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/torrent_download_limit_hint"
            app:helperText="@string/limit_helper_unlimited">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/torrent_download_limit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberSigned|numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/torrent_upload_limit_hint"
            app:helperText="@string/limit_helper_unlimited">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/torrent_upload_limit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberSigned|numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/share_ratio_limit"
            app:helperText="@string/limit_helper_global">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/torrent_ratio_limit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberSigned|numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/seeding_time_limit"
            app:helperText="@string/limit_helper_global_minutes">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/torrent_seeding_time_limit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberSigned" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/inactive_seeding_time_limit"
            app:helperText="@string/limit_helper_global_minutes">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/torrent_inactive_seeding_time_limit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberSigned" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</ScrollView>
