<?xml version="1.0" encoding="utf-8"?>
<!-- Fully transparent 24dp placeholder icon. qBC keeps a hidden close
     action as an invisible Spacer so the remaining actions never reflow
     while the query is empty; swapping the icon to this blank keeps the
     48dp slot reserved in the same way. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24" />
