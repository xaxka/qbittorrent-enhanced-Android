<?xml version="1.0" encoding="utf-8"?>
<!-- Port of LibreTorrent home menu (GPL-3.0): pause/resume all as visible
     toolbar icons. No overflow entries — log and about live in Settings, so
     no three-dot menu is shown at all. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/pause_all_menu"
        android:contentDescription="@string/pause_all"
        android:icon="@drawable/ic_pause_24px"
        android:title="@string/pause_all"
        app:showAsAction="ifRoom" />

    <item
        android:id="@+id/resume_all_menu"
        android:contentDescription="@string/resume_all"
        android:icon="@drawable/ic_play_arrow_24px"
        android:title="@string/resume_all"
        app:showAsAction="ifRoom" />
</menu>
