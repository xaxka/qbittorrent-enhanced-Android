<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- LibreTorrent component styles (GPL-3.0), preference-specific styles removed -->

    <style name="App.Components.ListItem" parent="Widget.Material3.CardView.Outlined">
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="checkedIcon">@null</item>
    </style>

    <style name="App.Components.ListItem.Label" parent="TextAppearance.Material3.BodyLarge" />

    <style name="App.Components.ListItem.SupportingText" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="App.Components.ErrorReportDialog.StackTrace" parent="TextAppearance.Material3.BodySmall">
        <item name="android:typeface">monospace</item>
    </style>

    <style name="App.Components.MaterialCard.Filled.SurfaceVariant" parent="Widget.Material3.CardView.Filled">
        <item name="android:backgroundTint">?attr/colorSurfaceContainer</item>
    </style>

    <style name="MaterialAlertDialog.App.Body.Text" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
    </style>

    <style name="Widget.App.SearchBar" parent="Widget.Material3.SearchBar">
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.App.AppBarLayout" parent="Widget.Material3.AppBarLayout">
        <item name="elevation">0dp</item>
    </style>

    <style name="App.Components.SwitchBar" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:padding">24dp</item>
    </style>

    <style name="TextAppearance.App.Components.SwitchBar" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
    </style>

    <style name="TextAppearance.App.SectionTitle" parent="TextAppearance.Material3.TitleSmall" />

    <!-- Material 3's LinearProgressIndicator draws a "stop indicator" dot
         at the end of the track by default (Widget.Material3 style sets
         trackStopIndicatorSize to the m3 dimen). This app shows plain
         progress tracks everywhere, so the dot is turned off globally via
         the theme default (linearProgressIndicatorStyle) — the attribute
         is the defStyleAttr of every LinearProgressIndicator, including
         the ones created without an explicit style.

         One spec for EVERY linear progress bar in the app (list rows,
         file rows, overview, peers, dialogs, loading strips):
         4dp thickness + 2dp track corner = the pill shape; indicator /
         track colors stay the M3 defaults (colorPrimary on
         colorSurfaceVariant) unless code overrides them semantically
         (torrent state color, file priority color — always paired with
         the matching translucent track, see TorrentStateColors). -->
    <style name="Widget.App.LinearProgressIndicator" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackStopIndicatorSize">0dp</item>
        <!-- the 4dp default gap before the (removed) stop indicator still
             gets cut out of the drawn bar, leaving a notch at the end —
             zero it too, or every bar looks broken near 100% -->
        <item name="trackGapSize">0dp</item>
        <item name="trackThickness">4dp</item>
        <item name="trackCornerRadius">2dp</item>
    </style>

    <!-- Drawer filter chips, laid out in equal-column grids
         (EqualColumnsChipGroup). Selection is signalled by the container
         color alone — the leading checkmark is suppressed because it shoves
         the label sideways in a fixed-width cell and causes avoidable "…".
         Inner paddings are tightened (default M3 reserves ~24dp) so the
         label gets most of the cell; single line + end ellipsis stays as
         the last-resort clip. Long translations are handled by the grid
         itself (adaptive column fallback), not by smaller text. -->
    <style name="Widget.App.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="checkedIconVisible">false</item>
        <item name="chipStartPadding">4dp</item>
        <item name="chipEndPadding">4dp</item>
        <item name="textStartPadding">4dp</item>
        <item name="textEndPadding">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
