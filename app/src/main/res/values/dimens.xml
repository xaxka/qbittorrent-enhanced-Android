<?xml version="1.0" encoding="utf-8"?>
<resources>
    <item name="match_parent" type="dimen">-1</item>

    <!-- Default screen margins, per the Android Design guidelines. -->

    <!-- Fab button -->
    <dimen name="fab_margin">16dp</dimen>

    <dimen name="min_width_dialog">300dp</dimen>
    <dimen name="dialog_padding">24dp</dimen>
    <dimen name="list_pane_width">@dimen/match_parent</dimen>
    <dimen name="details_pane_start_margin">0dp</dimen>
    <dimen name="list_item_one_line_height">56dp</dimen>
    <dimen name="list_item_two_lines_height">56dp</dimen>
    <dimen name="list_item_three_lines_height">72dp</dimen>
    <!-- Native-app look: the search bar sits directly under the status bar
         (LibreTorrent's 48dp floating margin left a blank strip). -->
    <dimen name="search_bar_top_margin">8dp</dimen>
    <dimen name="toolbar_top_margin">24dp</dimen>
    <!-- SearchBar width policy: on narrow screens the minimum is clamped to
         the parent (full-width bar); on wide screens the bar settles at this
         488dp target, centered. Named *_min_width because it is wired to
         android:minWidth on the SearchBar. -->
    <dimen name="search_bar_min_width">@dimen/text_field_max_width</dimen>
    <dimen name="text_field_max_width">488dp</dimen>
    <dimen name="bottom_bar_padding">80dp</dimen>
    <dimen name="list_fab_padding">72dp</dimen>
</resources>
